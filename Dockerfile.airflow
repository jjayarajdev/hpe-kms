FROM apache/airflow:2.8.0-python3.10

# Switch to root to install system packages
USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch back to airflow user
# Install uv for fast package installation (as root)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy requirements file
COPY requirements-airflow.txt /tmp/requirements-airflow.txt

# Install Python packages using uv (much faster than pip) - stay as root
RUN uv pip install --system --no-cache -r /tmp/requirements-airflow.txt

# Set Python path
ENV PYTHONPATH="/opt/airflow:/opt/airflow/src:${PYTHONPATH}"

# Switch back to airflow user
USER airflow
